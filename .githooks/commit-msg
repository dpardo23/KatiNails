#!/usr/bin/env bash
# Conventional Commits y solo los pies Refs: y BREAKING CHANGE:.
set -euo pipefail

if [ -z "${PROYECTO_RAIZ:-}" ]; then
  echo "commit-msg: FALLA: carga el entorno primero (source ./.entorno)." >&2
  exit 1
fi

pnpm exec commitlint --edit "$1"

# Textos prohibidos de una lista local opcional: vive en .git/info, nunca se versiona.
lista="$(git rev-parse --git-path info/textos-prohibidos)"
if [ -f "$lista" ] && grep -v '^#' "$1" | grep -qiF -f "$lista"; then
  echo "commit-msg: FALLA: el mensaje tiene un texto prohibido." >&2
  exit 1
fi
